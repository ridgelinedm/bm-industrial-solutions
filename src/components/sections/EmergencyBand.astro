---
import Band from "../Band.astro";
import Icon from "../Icon.astro";
import { COMPANY } from "../../data/content";
import { url } from "../../lib/site";
---
<section class="section section--tight">
  <div class="container container--wide">
    <Band
      photo={["fabrication-welding-shop", "Technician working on industrial equipment during an after-hours emergency call"]}
      title="When it fails at 2am, you still get a technician"
      lead="Breakdowns do not respect business hours. Our emergency line runs 24 hours a day, seven days a week. You reach someone who can diagnose the problem and dispatch a technician.">
      <div class="btn-row"><a class="btn btn--primary btn--lg" href={`tel:${COMPANY.phone_href}`}><Icon name="phone" size={18} /> {COMPANY.phone}</a><a class="btn btn--on-dark btn--lg" href={url("contact")}>Request a Quote</a></div>
    </Band>
  </div>
</section>
