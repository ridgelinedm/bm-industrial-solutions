---
import Icon from "./Icon.astro";
import { COMPANY, SERVICES, AREAS } from "../data/content";
import { url, asset } from "../lib/site";
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">
          <img src={asset("assets/img/logo/logo-full-reversed.png")} alt={COMPANY.name} width="210" height="68" loading="lazy">
        </div>
        <p class="footer__blurb">{COMPANY.tagline} Owner-operated industrial service out of {COMPANY.city}, {COMPANY.state}. Compressed air, hydraulics, mechanical contracting and process piping under one number.</p>
        <div class="footer__contact">
          <a href={`tel:${COMPANY.phone_href}`}><Icon name="phone" size={17} stroke={2.2} /> {COMPANY.phone}</a>
          <a href={`mailto:${COMPANY.email}`}><Icon name="mail" size={17} stroke={2.2} /> {COMPANY.email}</a>
        </div>
      </div>
      <div>
        <h2>Services</h2>
        <ul>{SERVICES.filter((s) => s.in_footer !== false).map((s) => <li><a href={url(s.path)}>{s.nav_title}</a></li>)}</ul>
      </div>
      <div>
        <h2>Service areas</h2>
        <ul>{AREAS.map((a) => <li><a href={url(a.path)}>{a.city}, {a.state}</a></li>)}<li><a href={url("service-areas")}>All service areas</a></li></ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href={url("about")}>About BM Industrial</a></li>
          <li><a href={url("services")}>All services</a></li>
          <li><a href={url("contact")}>Contact &amp; quotes</a></li>
          <li><a href={`tel:${COMPANY.phone_href}`}>24/7 emergency line</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bar">
      <p>&copy; <span id="year">2026</span> {COMPANY.legal_name}. All rights reserved.</p>
      <p>{COMPANY.city}, {COMPANY.state} {COMPANY.zip} · Serving SC, GA &amp; NC</p>
    </div>
  </div>
</footer>
