---
import Icon from "./Icon.astro";
import { AREAS, type Area } from "../data/content";
import { url } from "../lib/site";
interface Props { items?: Area[]; plain?: boolean }
const { items, plain = false } = Astro.props;
const list = items && items.length ? items : AREAS;
---
<div class="areas reveal">{list.map((a) => <a class={plain ? "area area--plain" : "area"} href={url(a.path)}><span><span class="area__name">{a.city}, {a.state}</span><span class="area__meta">{a.meta}</span></span><Icon name="arrow" size={18} /></a>)}</div>
