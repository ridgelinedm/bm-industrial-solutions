---
import { ICON_PATHS } from "./icons";
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" set:html={ICON_PATHS[name] ?? ""} />
