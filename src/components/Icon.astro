---
import { ICON_PATHS } from "./icons";
interface Props { name: string; size?: number; stroke?: number; class?: string }
const { name, size = 24, stroke = 2, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON_PATHS[name] ?? ""} />
