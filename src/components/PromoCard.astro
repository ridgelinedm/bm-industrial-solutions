---
import Tag from "./Tag.astro";
import { tagVariant } from "./tagOn";
import { href, asset } from "../lib/site";
export interface PromoSpec { surface?: string; tag?: string; title: string; body: string; label: string; href: string; gear?: boolean; btn_class?: string }
interface Props { spec: PromoSpec }
const { spec } = Astro.props;
const surface = spec.surface ?? "ink";
---
<div class={`promo promo--${surface} reveal`}>{spec.gear !== false && <img class="promo__gear" src={asset("assets/img/logo/icon-color.png")} alt="" aria-hidden="true" loading="lazy" width="618" height="473">}{spec.tag && <Tag text={spec.tag} variant={tagVariant(surface)} />}<h3 class="promo__title" set:html={spec.title} /><p set:html={spec.body} /><div class="promo__btn"><a class={spec.btn_class ?? "btn btn--light"} href={href(spec.href)} set:html={spec.label} /></div></div>
