---
import Icon from "./Icon.astro";
import { COMPANY } from "../data/content";
---
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__items">
      <span class="topbar__item"><span class="pulse"></span><strong>24/7 Emergency Service</strong></span>
      <span class="topbar__item topbar__hide-sm"><Icon name="pin" size={14} /> Serving South Carolina, Georgia &amp; North Carolina</span>
    </div>
    <div class="topbar__items">
      <a class="topbar__item" href={`mailto:${COMPANY.email}`}><Icon name="mail" size={14} /><span class="topbar__hide-sm">{COMPANY.email}</span></a>
      <a class="topbar__item" href={`tel:${COMPANY.phone_href}`}><Icon name="phone" size={14} /><strong>{COMPANY.phone}</strong></a>
    </div>
  </div>
</div>
